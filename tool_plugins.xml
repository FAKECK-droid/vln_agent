<class_libraries>
  <library path="vln_agent_tool_plugins">
    <class name="vln_agent/NavigateToPoseStartNavigation"
           type="vln_agent::NavigateToPoseStartNavigation"
           base_class_type="vln_agent::ToolPluginBase">
      <description>启动导航，目标接受后立即返回。</description>
    </class>
    <class name="vln_agent/NavigateToPoseGetFeedback"
           type="vln_agent::NavigateToPoseGetFeedback"
           base_class_type="vln_agent::ToolPluginBase">
      <description>查询共享导航任务。</description>
    </class>
    <class name="vln_agent/NavigateToPoseCancelNavigation"
           type="vln_agent::NavigateToPoseCancelNavigation"
           base_class_type="vln_agent::ToolPluginBase">
      <description>请求取消共享导航任务。</description>
    </class>
    <class name="vln_agent/NavigateThroughPosesStartNavigation"
           type="vln_agent::NavigateThroughPosesStartNavigation"
           base_class_type="vln_agent::ToolPluginBase">
      <description>NavigateThroughPoses StartNavigation，共用导航任务槽。</description>
    </class>
    <class name="vln_agent/NavigateThroughPosesGetFeedback"
           type="vln_agent::NavigateThroughPosesGetFeedback"
           base_class_type="vln_agent::ToolPluginBase">
      <description>NavigateThroughPoses GetFeedback，共用导航任务槽。</description>
    </class>
    <class name="vln_agent/NavigateThroughPosesCancelNavigation"
           type="vln_agent::NavigateThroughPosesCancelNavigation"
           base_class_type="vln_agent::ToolPluginBase">
      <description>NavigateThroughPoses CancelNavigation，共用导航任务槽。</description>
    </class>
    <class name="vln_agent/GetSurroundings"
           type="vln_agent::GetSurroundings"
           base_class_type="vln_agent::ToolPluginBase">
      <description>获取机器人朝上的环境图及可逆像素快照。</description>
    </class>
    <class name="vln_agent/NavigateToPixelStartNavigation"
           type="vln_agent::NavigateToPixelStartNavigation"
           base_class_type="vln_agent::ToolPluginBase">
      <description>将环境图像素目标与朝向转换到 map 后启动导航。</description>
    </class>
    <class name="vln_agent/NavigateThroughPixelsStartNavigation"
           type="vln_agent::NavigateThroughPixelsStartNavigation"
           base_class_type="vln_agent::ToolPluginBase">
      <description>将同一环境图中的有序像素目标转换后启动多点导航。</description>
    </class>
    <class name="vln_agent/NavigateToObjects" type="vln_agent::NavigateToObjects"
           base_class_type="vln_agent::ToolPluginBase">
      <description>复用实例深度投影，顺序启动单点或多点物体导航。</description>
    </class>
    <class name="vln_agent/NavigateToObjectsSurround" type="vln_agent::NavigateToObjectsSurround"
           base_class_type="vln_agent::ToolPluginBase">
      <description>使用环视拼图实例，复用物体导航停靠位姿及单点、多点 Action。</description>
    </class>
    <class name="vln_agent/CapturePair" type="vln_agent::CapturePair"
