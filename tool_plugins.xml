      <description>按实例提示分割或读取正点深度，返回目标坐标系中的三维均值。</description>
    </class>
    <class name="vln_agent/Lookaround" type="vln_agent::Lookaround" base_class_type="vln_agent::ToolPluginBase">
      <description>工具内完成转向、八对原图缓存与环视拼图。</description>
    </class>
    <class name="vln_agent/DepthProjectSurround" type="vln_agent::DepthProjectSurround" base_class_type="vln_agent::ToolPluginBase">
