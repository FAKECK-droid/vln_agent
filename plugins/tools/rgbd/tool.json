[
  {
    "type": "function",
    "name": "capture_pair",
    "description": "获取并保存已对齐的彩色/深度图、标定与采样时位姿，返回按配置缩放的彩色图和 data.pair_id。随后用 depth_project 查询实例位置。按 images[0].metadata.width/height 网格给点和框，左上角原点，x 向右、y 向下；工具处理原始深度映射。latest 取最新，index/age 取历史。缓存有上限，旧 pair_id 会被淘汰。",
    "async": true,
    "strict": true,
    "parameters": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "latest",
            "index",
            "age"
          ],
          "description": "latest 最新；index 历史索引；age 距当前的毫秒数。"
        },
        "detail": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "latest 填 0；index 从 0 表示最新；age 为毫秒，例如 1500。"
        }
      },
      "required": [
        "mode",
        "detail"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "depth_project",
    "description": "查询同一缓存 pair 的多个实例并返回目标坐标系中的可见表面三维均值（米）。use_segmentation=true 时用各实例独立的点和框调用 MobileSAM，对掩码内全部有效原始深度投影并求均值；false 时忽略框及负点，只对正点的有效深度求均值。所有提示使用 capture_pair 返回图的实际尺寸，无需自行缩放。结果 data.instances 保持输入顺序，逐项返回 index/ok/sample_count/x/y/z/depth_m 或 code/message，分割时附 mask_score。部分实例失败保留其余结果，全失败则顶层 ok=false。坐标使用采样时固定系位姿；其他 target_frame 使用当前 TF。均值表示可见表面，不等同于物体体积中心或停车点。",
    "async": true,
    "strict": true,
    "parameters": {
      "type": "object",
      "properties": {
        "pair_id": {
          "type": "string",
          "description": "capture_pair 返回的 data.pair_id。"
        },
        "target_frame": {
          "type": "string",
          "description": "输出坐标系，例如 map 或 base_link。"
        },
        "use_segmentation": {
          "type": "boolean",
          "description": "true 分割实例掩码；false 只使用正类提示点。"
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "box": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "x_min": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "左边界。"
                  },
                  "y_min": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "上边界。"
                  },
                  "x_max": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "右边界，可等于图片宽度。"
                  },
                  "y_max": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "下边界，可等于图片高度。"
                  }
                },
                "required": [
                  "x_min",
                  "y_min",
                  "x_max",
                  "y_max"
                ],
                "additionalProperties": false,
                "description": "实例提示框，按返回图片的边界坐标填写；无需框时填 null。"
              },
              "points": {
                "type": "array",
                "maxItems": 63,
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "返回图片上的横向零基像素。"
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "返回图片上的纵向零基像素。"
                    },
                    "label": {
                      "type": "integer",
                      "enum": [
                        0,
                        1
                      ],
                      "description": "1 前景正点，0 背景负点。"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "label"
                  ],
                  "additionalProperties": false
                },
                "description": "本实例独立的提示点。分割时纯点最多 63，带框最多 62；关闭分割时只读取 label=1 的点。"
              }
            },
            "required": [
              "box",
              "points"
            ],
            "additionalProperties": false
          },
          "description": "每项对应一个检测实例，提示相互独立，结果顺序一致。"
        }
      },
      "required": [
        "pair_id",
        "target_frame",
        "use_segmentation",
        "instances"
      ],
      "additionalProperties": false
    }
  }
]
