        "x": {
          "type": "number",
          "description": "目标 x 坐标，单位米。"
        },
        "y": {
          "type": "number",
          "description": "目标 y 坐标，单位米。"
        },
        "yaw": {
          "type": "number",
          "description": "目标朝向，单位弧度。"
        }
      },
      "required": [
        "frame_id",
        "x",
        "y",
        "yaw"
      ],
      "additionalProperties": false
    }
  },
  {
